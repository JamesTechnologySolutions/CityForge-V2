{
  "name": "cityforge",
  "version": "1.0.0",
  "description": "A 3D city-building simulation by James Technology Solutions",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never",
    "test": "node --check main.js && node --input-type=module --check < src/game3d.js"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jamestechnologysolutions.cityforge",
    "productName": "CityForge",
    "copyright": "Copyright © 2026 James Technology Solutions",
    "asar": true,
    "files": [
      "main.js",
      "src/**/*",
      "node_modules/three/**/*",
      "icon.ico",
      "logo.png",
      "license.txt",
      "installer.nsh",
      "installerSidebar.bmp"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "CityForge-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "license.txt",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "installerSidebar": "installerSidebar.bmp",
      "uninstallerSidebar": "installerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CityForge",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    },
    "portable": {
      "artifactName": "CityForge-${version}-Portable.${ext}"
    }
  }
}
