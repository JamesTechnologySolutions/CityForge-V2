{
  "name": "cityforge",
  "version": "0.2.0",
  "description": "A free, unlimited city-building game for Windows",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win" },
  "license": "MIT",
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.cityforge.game",
    "productName": "Cityforge",
    "files": ["main.js", "src/**/*"],
    "win": { "target": ["nsis", "portable"] }
  }
}
